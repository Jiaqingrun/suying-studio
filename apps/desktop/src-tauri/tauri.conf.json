{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "速影 Studio",
  "version": "0.8.11",
  "identifier": "com.qr.suying",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "速影 Studio",
        "width": 1280,
        "height": 860,
        "backgroundColor": "#F4F6F8"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' asset: http://asset.localhost blob: data: http://127.0.0.1:* http://localhost:*; media-src 'self' asset: http://asset.localhost blob: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**/*",
            "/Volumes/**/*",
            "/Users/**/*",
            "/**/*"
          ],
          "deny": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "速影 Studio — 本地 AI 混剪工作台",
    "longDescription": "速影 Studio 一体包：素材入库、FFmpeg 生产、审片、物料、发布与触达。日更引擎内嵌于 App；Ollama 与片库仍在本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
