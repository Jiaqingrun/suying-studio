  "piece_type_rules": {
    "配送承诺": {
      "template": "fast-ship",
      "slots": {
        "hook": {"prefer_scenes": ["仓内货架", "产品特写"], "prefer_objects": []},
        "body": {"prefer_scenes": ["仓内货架", "装车卸货"], "prefer_objects": ["货车", "货架", "三轮车"]},
        "cta": {"prefer_scenes": ["装车卸货", "门店门头"], "prefer_objects": ["货车"]}
      },
      "continuity": {"require_scene_or_object": true, "max_object_kinds": 4}
    },
    "单品介绍": {
      "template": "stable-product",
      "slots": {
        "hook": {"prefer_scenes": ["产品特写"], "prefer_objects": ["五金工具", "钢筋机械"]},
        "body": {"prefer_scenes": ["产品特写", "仓内货架"], "prefer_objects": ["五金工具", "钢筋机械", "货架"]},
        "cta": {"prefer_scenes": ["仓内货架", "门店门头"], "prefer_objects": []}
      },
      "continuity": {"require_scene_or_object": true, "max_object_kinds": 3}
    },
    "门店实力": {
      "template": "default-vertical",
      "slots": {
        "hook": {"prefer_scenes": ["门店门头"], "prefer_objects": []},
        "body": {"prefer_scenes": ["门店门头", "仓内货架"], "prefer_objects": ["货架"]},
        "cta": {"prefer_scenes": ["装车卸货", "仓内货架"], "prefer_objects": ["货车"]}
      },
      "continuity": {"require_scene_or_object": true, "max_object_kinds": 4}
    },
    "综合日更": {
      "template": "default-vertical",
      "slots": {},
      "continuity": {"require_scene_or_object": true, "max_object_kinds": 5}
    }
  },
