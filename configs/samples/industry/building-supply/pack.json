  "narration_lines": {
    "配送": [
      "顺着车斗，把装货点走顺一遍。",
      "工人把货往车上码稳，动作利索不乱。",
      "厢式车门拉开就能装，节奏跟着车走。",
      "三轮车斗里一件件码齐，看着也踏实。",
      "装完再拍拍固定绳，细节不放过。",
      "出库口车已经排上了，现场一阵忙碌。",
      "货跟着车斗往工地去，过程清楚。",
      "装车节奏是快、稳、齐，一步也不糊弄。",
      "先把大件垫好再码小件，叠得住。",
      "车斗装平，缝隙填实，走起来更稳。",
      "发车前再看一眼固定，核对到位。",
      "送货这一路，跟着镜头把现场看完。",
      "卸货点工人接着接板，衔接顺畅。",
      "工作人员正忙碌地装载核对，一气呵成。"
    ],
    "仓配": [
      "货架上一排一排放齐。",
      "拣货走道留出通道。",
      "库房灯下能看清单。",
      "码垛按层码得住。",
      "分拣筐里先归一类。",
      "仓内动作干脆不拖。",
      "货架深位也够得着。",
      "装卸口就在前场。",
      "配货单对着货位走。",
      "堆得整，才好再拿。",
      "仓库一角货量能看清。",
      "拣完再复核件数。",
      "通道干净，车能拐弯。",
      "仓配节奏：拣、码、出。"
    ],
    "门店": [
      "门头招牌先入画。",
      "展厅货样一排摆开。",
      "柜台前能看得见货。",
      "店内通道走得开。",
      "样品挂墙一清二楚。",
      "门店灯光明亮实在。",
      "货架陈列按类分区。",
      "门口能看见仓配口。",
      "展台细节近镜扫过。",
      "店里货量跟仓里连。",
      "前场接待，后场配货。",
      "门店就是仓库的脸面。",
      "柜台上放着常用件。",
      "从门头走到库区顺。"
    ],
    "施工机械": [
      "机器上工位站稳了。",
      "切断机一开一停清楚。",
      "弯曲机把钢筋弯到位。",
      "操作台面干干净净。",
      "调直段拉得直。",
      "设备噪声里动作准。",
      "飞轮护罩扣得牢。",
      "刀具位置对得上。",
      "台面下角料先收好。",
      "开机前再看一眼开关。",
      "弯箍成形一次过型。",
      "机械动作跟着节拍。",
      "近镜看见齿轮咬合。",
      "完工先关机再收料。"
    ],
    "产品": [
      "扳手类，紧固拆装好搭档。",
      "钳类工具，剪切夹持常用。",
      "钢卷尺，现场量尺好带。",
      "电动工具，钻孔装配更利索。",
      "套筒系列，拧紧拆卸省力。",
      "焊条焊丝，现场施焊配套。",
      "砂轮切割，开料断料少不了。",
      "钻头系列，开孔钻孔常用。",
      "劳防手套，搬运操作保手。",
      "电缆线材，布线供电用得上。",
      "紧固件，装配固定少不了。",
      "五金耗材，工地门店都用得着。",
      "加料斗，投料转运更方便。",
      "实用工具，日常作业常备。",
      "看中的型号到店直接拿。",
      "缺哪样现货跟我们配。",
      "单买成套都按需拿。",
      "防水卷材，屋面墙面常用配套。",
      "保温材料，现场保温层常备。",
      "消防器材，工地配套少不了。",
      "消防设施，按需核对型号。",
      "水暖管件，管道连接常用。",
      "阀门系列，供水管路配套。"
    ],
    "default": [
      "跟着镜头看现场动作。",
      "可见的每一步都拍到。",
      "工人步骤边干边过。",
      "货与车与人同框。",
      "现场先看清楚再说。",
      "细节落在当前画面。",
      "作业线从左扫到右。",
      "近镜再给一处重点。",
      "一镜过完再落点。",
      "真实现场，不添戏。",
      "先看懂再细问品类。",
      "镜头停在看得见的地方。"
    ]
  }
}
