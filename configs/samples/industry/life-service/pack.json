    "品牌故事": ["品牌故事", "company_image"],
    "default": ["default", "门店形象"]
  },
  "template_bindings": {
    "门店": "default-vertical",
    "护理": "stable-product",
    "产品": "stable-product",
    "护肤": "stable-product",
    "品牌": "default-vertical"
  },
  "piece_type_bindings": {
    "门店形象": "门店实力",
    "护肤护理": "单品介绍",
    "身体与形体": "单品介绍",
    "服务沟通": "综合日更",
    "品牌故事": "门店实力",
    "default": "综合日更"
  },
  "piece_type_rules": {
    "门店实力": {
      "template": "default-vertical",
      "slots": {
        "hook": {"prefer_scenes": ["storefront", "company_image"], "prefer_objects": []},
        "body": {"prefer_scenes": ["office", "company_image", "storefront"], "prefer_objects": ["荣誉墙", "接待台"]},
        "cta": {"prefer_scenes": ["storefront", "office"], "prefer_objects": []}
      },
      "continuity": {"require_scene_or_object": false, "max_object_kinds": 6}
    },
    "单品介绍": {
      "template": "stable-product",
      "slots": {
        "hook": {"prefer_scenes": ["product_closeup", "product_use", "office"], "prefer_objects": ["护理品"]},
        "body": {"prefer_scenes": ["product_use", "product_closeup", "office"], "prefer_objects": ["护理台", "护理品"]},
        "cta": {"prefer_scenes": ["office", "storefront"], "prefer_objects": []}
      },
      "continuity": {"require_scene_or_object": false, "max_object_kinds": 6}
    },
    "综合日更": {
      "template": "default-vertical",
      "slots": {},
      "continuity": {"require_scene_or_object": false, "max_object_kinds": 6}
    }
  },
