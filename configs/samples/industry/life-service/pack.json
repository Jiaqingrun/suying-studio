  "narration_lines": {
    "门店形象": [
      "先进门，把店里的样子看清楚。",
      "通道干净，走起来也不着急。",
      "灯光柔和，坐着不刺眼。",
      "店内空间规整，动线清楚。",
      "休息区安静，适合慢慢待着。"
    ],
    "护肤护理": [
      "护理台面干净，步骤所需都在顺手处。",
      "用品整齐备好，动手前都准备妥当。",
      "过程按步骤来，细致不慌。",
      "护理细节都在眼前画面里。"
    ],
    "身体与形体": [
      "床位收拾妥当，空间安静。",
      "护理节奏放缓，方便好好放松。",
      "环境整洁，细节看得见。"
    ],
    "服务沟通": [
      "到店先安顿好，再慢慢说需求。",
      "先听完想法，再一起商量安排。",
      "接待有序，不催不赶。"
    ],
    "品牌故事": [
      "荣誉墙上能看见这些年留下的痕迹。",
      "品牌介绍一字排开，先把来历看明白。",
      "本地连锁的样子，挂在墙上也清楚。"
    ],
    "default": [
      "跟着镜头把店里看一遍。",
      "可见的空间与细节都在画面里。",
      "先看明白在场发生什么。",
      "环境干净，节奏也不赶。"
    ]
  }
